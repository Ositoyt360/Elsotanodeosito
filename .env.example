# Copia este archivo como ".env" (o crea estas variables en tu hosting).
# NUNCA subas el archivo .env a GitHub ni pongas la llave dentro de index.html.
ANTHROPIC_API_KEY=sk-ant-PEGA-AQUI-TU-LLAVE
# Opcional: modelo (por defecto el rápido y barato). Para respuestas más profundas: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Opcionales: límites contra abuso
# IA_MAX_POR_MINUTO=12
# IA_MAX_POR_DIA_IP=150
# IA_MAX_POR_DIA_TOTAL=4000
# V49: si tu página está en hosting estático (GitHub Pages) y este servidor en otro lugar, limita quién puede usar la IA:
# IA_ALLOWED_ORIGINS=https://tuusuario.github.io
