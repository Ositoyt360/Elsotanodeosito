rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCreator() {
      return signedIn() && request.auth.token.email == 'ositoyt360@elsotanodeosito.com';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && (
        request.auth.uid == userId ||
        isCreator()
      );
      allow delete: if false;
    }

    match /aiChats/{userId}/messages/{messageId} {
      allow read, create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /livechat/{messageId} {
      // Chat público del sitio: cualquiera puede leer y publicar mensajes.
      // Los datos privados del usuario siguen protegidos en /users y /aiChats.
      allow read: if true;
      allow create: if (!messageId.matches('rank_.*') && !messageId.matches('profile_.*')) || isCreator();
      allow update: if (!messageId.matches('rank_.*') && !messageId.matches('profile_.*')) || isCreator();
      allow delete: if isCreator();
    }
  }
}
