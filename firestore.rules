rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /aiChats/{userId}/messages/{messageId} {
      allow read, create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /livechat/{messageId} {
      // Chat público del sitio: cualquiera puede leer y publicar mensajes.
      // Los datos privados del usuario siguen protegidos en /users y /aiChats.
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
