rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCreator() {
      return signedIn() && request.auth.token.email == 'ositoyt360@elsotanodeosito.com';
    }
    function isLimitedModerator() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email.split('@')[0] == 'denis';
    }
    function isBanned(uid) {
      return exists(/databases/$(database)/documents/moderation/$(uid)) &&
        get(/databases/$(database)/documents/moderation/$(uid)).data.bannedUntil > request.time.toMillis();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCreator());
      allow create, update: if signedIn() && (request.auth.uid == userId || isCreator());
      // El moderador limitado (Denis) puede borrar mensajes del chat,
      // pero no perfiles ni rangos. Esto permite moderación directa desde
      // GitHub Pages sin depender del backend Express.
      allow delete: if isCreator();
    }

    match /moderation/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCreator());
      allow create, update, delete: if isCreator();
    }

    match /siteSettings/public {
      allow read: if true;
      allow create: if isCreator();
      allow update: if isCreator();
      allow delete: if isCreator();
    }

    match /aiChats/{userId}/messages/{messageId} {
      allow read, create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /livechat/{messageId} {
      allow read: if true;

      // Perfiles públicos: cada usuario puede mantener su propia foto/rango visible.
      allow create: if
        (messageId.matches('profile_.*') && signedIn() && request.resource.data.uid == request.auth.uid) ||
        (!messageId.matches('profile_.*') && !messageId.matches('rank_.*') && signedIn() && !isBanned(request.auth.uid) && (!request.resource.data.isSystem || isCreator() || isLimitedModerator())) ||
        isCreator();

      allow update: if
        (messageId.matches('profile_.*') && signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) ||
        (!messageId.matches('profile_.*') && !messageId.matches('rank_.*') && signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.timestamp == resource.data.timestamp && !isBanned(request.auth.uid)) ||
        isCreator();

      // Denis puede borrar mensajes normales desde GitHub Pages, pero no perfiles/rangos.
      allow delete: if isCreator() || (isLimitedModerator() && !messageId.matches('profile_.*') && !messageId.matches('rank_.*'));
    }
  }
}
